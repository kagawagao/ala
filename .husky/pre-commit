#!/bin/sh
# Run frontend lint and format before commit

# Frontend lint
cd frontend && npm run lint --silent
if [ $? -ne 0 ]; then
  echo "Frontend ESLint failed. Run 'npm run lint:fix' to fix."
  exit 1
fi

# Prettier format (JS/TS/JSON/YAML/MD)
cd .. && npx prettier --write "**/*.{ts,tsx,js,jsx,json,md,css,yaml,yml}" --ignore-path .prettierignore --log-level warn
if [ $? -ne 0 ]; then
  echo "Prettier format failed."
  exit 1
fi
git add -u

# Backend Python: ruff lint + format
if command -v poetry >/dev/null 2>&1; then
  cd backend && poetry run ruff check src/ tests/ --fix --quiet
  if [ $? -ne 0 ]; then
    echo "Ruff lint failed."
    exit 1
  fi
  poetry run ruff format src/ tests/ --quiet
  if [ $? -ne 0 ]; then
    echo "Ruff format failed."
    exit 1
  fi
  cd ..
  git add -u
fi

echo "Pre-commit checks passed"
